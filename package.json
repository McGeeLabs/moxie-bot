{
  "name": "moxie-bot",
  "version": "0.1.0",
  "description": "A modular, self-hosted Discord bot built with TypeScript, Discord.js, and PostgreSQL.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run db:generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "npm run build && node dist/core/database/check.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/index.js",
    "deploy": "npm run build && node dist/deploy-commands.js"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "postgresql"
  ],
  "author": "McGee Labs",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
