# Copy to .env.docker on the Docker host. Keep local .env for the SSH tunnel.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
MOXIE_CONTAINER_NAME=moxie-bot

# Existing database mode (compose.yaml): select a network mcgee-postgres uses.
MOXIE_DB_NETWORK=replace_with_existing_postgres_network
# Optional compose.integrations.yaml: shared network with Uptime Kuma.
MOXIE_INTEGRATION_NETWORK=mcgee_proxy
# URL-encode credentials. Use a Docker hostname, not the local SSH tunnel.
DATABASE_URL=postgresql://moxie:URL_ENCODED_PASSWORD@mcgee-postgres:5432/moxie?schema=public

# Fresh database mode (compose.standalone.yaml) only:
# Change DATABASE_URL above to hostname postgres and matching credentials/name.
# POSTGRES_PASSWORD is the actual password, not its URL-encoded form.
POSTGRES_DB=moxie
POSTGRES_USER=moxie
POSTGRES_PASSWORD=

# Optional API: containers listen on port 3000 when enabled.
WEBHOOK_ENABLED=false
# Host port used by the optional compose.webhooks.yaml override.
WEBHOOK_PORT=3000

# Optional admin dashboard. Register DASHBOARD_BASE_URL/callback in Discord OAuth2 settings.
# Use HTTPS through the existing reverse proxy on mcgee_proxy. Keep the client secret out of Git.
DASHBOARD_ENABLED=false
DASHBOARD_CLIENT_SECRET=
DASHBOARD_BASE_URL=
