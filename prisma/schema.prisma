generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   GuildModuleConfig[]
  webhooks  WebhookRoute[]
  valheim   ValheimServerConfig?
  moderation ModerationConfig?
  moderationCases ModerationCase[]
}

model WebhookRoute {
  id         String   @id @default(uuid())
  guildId    String
  name       String
  channelId  String
  secretHash String
  provider   WebhookProvider @default(generic)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
}

enum WebhookProvider {
  generic
  uptimeKuma
}

model GuildModuleConfig {
  guildId   String
  module    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, module])
}

model ValheimServerConfig {
  guildId   String   @id
  host      String
  gamePort  Int
  queryPort Int
  channelId String
  monitorStatus ValheimMonitorStatus?
  lastNotifiedStatus ValheimMonitorStatus?
  consecutiveFailures Int @default(0)
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

enum ValheimMonitorStatus {
  online
  unavailable
}

model ModerationConfig {
  guildId      String   @id
  logChannelId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ModerationCase {
  id              String   @id @default(uuid())
  guildId         String
  targetUserId    String
  moderatorUserId String
  action          ModerationAction @default(warn)
  reason          String
  durationMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reasonUpdatedAt DateTime?
  reasonUpdatedById String?
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, targetUserId, createdAt])
}

enum ModerationAction {
  warn
  timeout
  untimeout
  kick
  ban
}
