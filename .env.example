# Runtime requires only the token. Never commit .env.
DISCORD_TOKEN=your_bot_token
# These IDs are required by npm run deploy (guild command registration).
DISCORD_CLIENT_ID=your_app_client_id
DISCORD_GUILD_ID=your_test_guild_id
# Optional database. Local development uses the SSH tunnel on port 5433.
# Use a dedicated development database and URL-encode credentials.
# DATABASE_URL="postgresql://moxie:your_url_encoded_password@127.0.0.1:5433/moxie_dev?schema=public"
DATABASE_URL=

# Optional incoming webhook API. Routes use generated per-route Bearer tokens.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=3000
